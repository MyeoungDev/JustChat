{
  "name": "just-chat",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal desktop shell for chatting with AI providers",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:perf": "electron-vite dev -- --just-chat-perf",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
