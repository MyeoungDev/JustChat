{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Chat Tauri",
  "version": "0.1.0",
  "identifier": "com.myeoungdev.justchat.tauri",
  "build": {
    "beforeDevCommand": "pnpm tauri:dev-frontend",
    "devUrl": "http://127.0.0.1:1420/tauri.html",
    "beforeBuildCommand": "pnpm tauri:build-frontend",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": ["../assets/icon.png", "../assets/icon.icns", "../assets/icon.ico"],
    "targets": ["app", "dmg"]
  }
}
